# 服务器配置
PORT=3001
NODE_ENV=development

# JWT配置
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# AI服务配置 (ARK/Kimi)
ARK_API_KEY=your-ark-api-key-here
ARK_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL=kimi-k2-250711

# KIMI服务配置 (Moonshot AI)
KIMI_API_KEY=your-kimi-api-key-here
KIMI_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0905-preview

# 默认AI提供商 (ark 或 kimi)
DEFAULT_AI_PROVIDER=ark

# Supabase配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# CORS配置
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 前端环境变量 (用于Vercel部署)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe支付配置
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID_PRO=price_your_pro_plan_price_id_here
STRIPE_CURRENCY=usd

# 前端Stripe配置
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# 前端URL配置
FRONTEND_URL=http://localhost:3000

# 实时对话 API（OpenAI Realtime 兼容，如 hrqdapi.cn）
GPT_REALTIME_API_KEY=your-realtime-api-key-here
GPT_REALTIME_WS_URL=wss://hrqdapi.cn/v1/realtime 